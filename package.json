{
  "name": "leadform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch server.js",
    "build": "node --check server.js && node --check public/app.js",
    "check": "npm run build && node --check db/schema.mjs && node --check .neander/seed.mjs && node --check scripts/verify-template.mjs",
    "test": "node --test scripts/template.test.mjs",
    "db:seed": "node --env-file-if-exists=.env .neander/seed.mjs",
    "test:template": "node scripts/verify-template.mjs",
    "test:policy": "python3 scripts/check_repository.py",
    "verify": "npm run check && npm run test && npm run test:policy && npm run build",
    "test:production": "node scripts/verify-template.mjs"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dompurify": "3.4.18",
    "express": "^4.21.2",
    "express-rate-limit": "8.7.5",
    "express-session": "^1.18.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  },
  "license": "MIT"
}
